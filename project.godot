; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="冥河，冥河！"
config/description="一款以楚文化、生死同构与编钟波纹为核心的双键节奏游戏。"
config/version="0.1.0-mvp"
run/main_scene="res://scenes/app/app_main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

AppRouter="*res://src/services/navigation/app_router.gd"
ContentCatalog="*res://src/services/catalog/content_catalog.gd"
SaveService="*res://src/services/save/save_service.gd"
SettingsService="*res://src/services/settings/settings_service.gd"
MenuAudioService="*res://src/services/menu_audio/menu_audio_service.gd"
InputEventBuffer="*res://src/runtime/input/input_event_buffer.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/minghe_chart_editor/plugin.cfg", "res://addons/parallax_background_editor/plugin.cfg")


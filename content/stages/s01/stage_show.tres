[gd_resource type="Resource" script_class="StageShow" load_steps=4 format=3]

[ext_resource type="Script" path="res://src/content/resources/stage_show.gd" id="1_show"]
[ext_resource type="Script" path="res://src/content/resources/show_cue.gd" id="2_cue"]

[sub_resource type="Resource" id="Cue_intro"]
script = ExtResource("2_cue")
event_id = "show_s01_intro"
tick = 0
track = 5
cue_id = &"tutorial_free_carrier"
target_slot = &"hud"
parameters = {"display_sec": 5.0, "text": "空按测试：左键/F/L1按住死钟，右键/J/R1按住生钟；可单独按住，也可双钟齐鸣"}

[sub_resource type="Resource" id="Cue_dual"]
script = ExtResource("2_cue")
event_id = "show_s01_dual_hold"
tick = 7680
track = 5
cue_id = &"tutorial_free_carrier_dual"
target_slot = &"hud"
parameters = {"display_sec": 4.0, "text": "现在同时按住两口钟，观察朱、玄波是否持续，以及重叠处的骨白相纹是否稳定"}

[resource]
script = ExtResource("1_show")
schema_version = 1
show_id = "s01_free_carrier_show"
cues = [SubResource("Cue_intro"), SubResource("Cue_dual")]

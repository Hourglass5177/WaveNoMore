[gd_resource type="Resource" script_class="StageShow" load_steps=13 format=3]

[ext_resource type="Script" path="res://src/content/resources/stage_show.gd" id="1_show"]
[ext_resource type="Script" path="res://src/content/resources/show_cue.gd" id="2_cue"]

[sub_resource type="Resource" id="Cue_intro"]
script = ExtResource("2_cue")
event_id = "show_tuning_lab_intro"
tick = 0
track = 5
cue_id = &"tutorial_tuning_lab_intro"
target_slot = &"hud"
parameters = {"display_sec": 3.2, "text": "按住任意一口钟都会持续发波：左键/F是死钟，右键/J是生钟；普通段频率固定"}

[sub_resource type="Resource" id="Cue_find"]
script = ExtResource("2_cue")
event_id = "show_tuning_lab_find"
tick = 2400
track = 5
cue_id = &"tutorial_tuning_find"
target_slot = &"hud"
parameters = {"display_sec": 3.2, "text": "调频场亮起后才可改频。先看上方朱轨：按住右键并横向拖动，让游标跟在亮带内"}

[sub_resource type="Resource" id="Cue_find_rift"]
script = ExtResource("2_cue")
event_id = "show_tuning_lab_find_rift"
tick = 2880
duration_ticks = 2880
track = 3
cue_id = &"open_tuning_rift"
target_slot = &"boundary"
parameters = {"intensity": 0.55}

[sub_resource type="Resource" id="Cue_manifestation_a"]
script = ExtResource("2_cue")
event_id = "show_tuning_lab_manifestation_a"
tick = 5280
track = 5
cue_id = &"tutorial_su_manifestation"
target_slot = &"hud"
parameters = {"display_sec": 2.4, "text": "素音会在两列波真正相叠的骨白交点凝现；它是调频结果，不是第三条要点击的音符"}

[sub_resource type="Resource" id="Cue_rest"]
script = ExtResource("2_cue")
event_id = "show_tuning_lab_rest"
tick = 6240
track = 5
cue_id = &"tutorial_tuning_rest"
target_slot = &"hud"
parameters = {"display_sec": 2.4, "text": "滑条结束不判松键；调频场关闭后，新发出的波会自动恢复4.35 Hz基频"}

[sub_resource type="Resource" id="Cue_follow"]
script = ExtResource("2_cue")
event_id = "show_tuning_lab_follow"
tick = 8160
track = 5
cue_id = &"tutorial_tuning_follow"
target_slot = &"hud"
parameters = {"display_sec": 3.4, "text": "第二段是双侧往返：手柄左摇杆控死、右摇杆控生；到端头看折返箭头，再沿粗轨滑回"}

[sub_resource type="Resource" id="Cue_follow_rift"]

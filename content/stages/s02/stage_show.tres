[gd_resource type="Resource" script_class="StageShow" load_steps=7 format=3]

[ext_resource type="Script" path="res://src/content/resources/stage_show.gd" id="1_show"]
[ext_resource type="Script" path="res://src/content/resources/show_cue.gd" id="2_cue"]

[sub_resource type="Resource" id="Cue_intro"]
script = ExtResource("2_cue")
event_id = "show_s02_intro"
tick = 0
track = 5
cue_id = &"tutorial_tap_intro"
target_slot = &"hud"
parameters = {"display_sec": 4.0, "text": "Tap 专项：右上朱音用右键/J/R1，左下玄音用左键/F/L1；进度环在中心闭合时敲"}

[sub_resource type="Resource" id="Cue_eighth"]
script = ExtResource("2_cue")
event_id = "show_s02_eighth"
tick = 11520
track = 5
cue_id = &"tutorial_tap_eighth"
target_slot = &"hud"
parameters = {"display_sec": 2.8, "text": "接下来是八分短句：先盯住中心落点，再用颜色判断左右手"}

[sub_resource type="Resource" id="Cue_chord"]
script = ExtResource("2_cue")
event_id = "show_s02_chord"
tick = 26880
track = 5
cue_id = &"tutorial_tap_chord"
target_slot = &"hud"
parameters = {"display_sec": 2.8, "text": "朱、玄同时抵达时双键齐敲；下一拍会有单侧应答"}

[sub_resource type="Resource" id="Cue_mixed"]
script = ExtResource("2_cue")
event_id = "show_s02_mixed"
tick = 34560
track = 5
cue_id = &"tutorial_tap_mixed"
target_slot = &"hud"
parameters = {"display_sec": 2.5, "text": "最后把交替、重复和短切分连起来，仍只需要在中心读一个落点"}

[resource]
script = ExtResource("1_show")
schema_version = 1
show_id = "s02_tap_lab_show"
cues = [SubResource("Cue_intro"), SubResource("Cue_eighth"), SubResource("Cue_chord"), SubResource("Cue_mixed")]

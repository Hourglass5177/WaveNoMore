tick = 4080
track = 5
cue_id = &"tutorial_tuning_pair"
target_slot = &"hud"
parameters = {"display_sec": 2.6, "text": "双轨同现时两口钟分别跟随；PC双键拖动只是单鼠标简测，完整双路操作请用手柄"}

[sub_resource type="Resource" id="Cue_death_solo"]

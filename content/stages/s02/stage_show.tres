duration_ticks = 3840
track = 3
cue_id = &"open_tuning_rift"
target_slot = &"boundary"
parameters = {"intensity": 0.85}

[sub_resource type="Resource" id="Cue_pair_controls"]
script = ExtResource("2_cue")

tick = 53760
track = 5
cue_id = &"tutorial_rotary_chain"
target_slot = &"hud"
parameters = {"display_sec": 5.5, "text": "休两拍后，用死钟连续完成三段短弧。后一条会提前缩圈，每段仍有自己的起手。"}

[resource]
script = ExtResource("1_show")

track = 5
cue_id = &"tutorial_rotary_horizontal"
target_slot = &"hud"
parameters = {"display_sec": 5.5, "text": "先走完四拍长弧，再接两段两拍短弧。看各自缩圈，沿箭头连续转。"}

[sub_resource type="Resource" id="Cue_orientation"]
script = ExtResource("2_cue")
event_id = "show_s04_orientation"
tick = 15360
track = 5
cue_id = &"tutorial_rotary_orientation"
target_slot = &"hud"
parameters = {"display_sec": 5.0, "text": "接下来各做一条斜弧和纵弧。只看当前最亮的滑条，较暗的是下一条预告。"}

[sub_resource type="Resource" id="Cue_dual"]
script = ExtResource("2_cue")

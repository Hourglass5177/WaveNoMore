parameters = {"display_sec": 5.0, "text": "先按住两口钟观察载波。摇杆要沿圆弧转动；只推住不转不会调频。"}

[sub_resource type="Resource" id="Cue_horizontal"]
script = ExtResource("2_cue")
event_id = "show_s04_horizontal"

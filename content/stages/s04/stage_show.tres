tick = 30720
track = 5
cue_id = &"tutorial_rotary_dual"
target_slot = &"hud"
parameters = {"display_sec": 4.5, "text": "双钟阶段：两条滑槽同拍开始、同拍结束。先横向，再斜向、纵向。"}

[sub_resource type="Resource" id="Cue_long"]
script = ExtResource("2_cue")
event_id = "show_s04_long"
tick = 42240
track = 5
cue_id = &"tutorial_rotary_long"
target_slot = &"hud"
parameters = {"display_sec": 4.5, "text": "这一条更长，但给足八拍。可以在虚线到达前完成，系统会等到尾拍再结算。"}

[sub_resource type="Resource" id="Cue_round"]
